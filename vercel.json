{
  "buildCommand": "pnpm --filter @workspace/tictactoe exec vite build --config vite.config.ts",
  "outputDirectory": "artifacts/tictactoe/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "env": {
    "NODE_ENV": "production",
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
