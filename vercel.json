{
  "buildCommand": "cd artifacts/tictactoe && pnpm run build",
  "outputDirectory": "artifacts/tictactoe/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "env": {
    "NODE_ENV": "production",
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
