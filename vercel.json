{
  "buildCommand": "pnpm --filter @workspace/tictactoe run build && ls -la artifacts/tictactoe/dist",
  "outputDirectory": "artifacts/tictactoe/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "env": {
    "NODE_ENV": "production",
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
